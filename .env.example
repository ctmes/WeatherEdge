# WeatherEdge Configuration
# Copy this to .env and fill in values

# Database URL — defaults to local SQLite if not set
# DATABASE_URL=sqlite+aiosqlite:///weatheredge.db
# For PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/weatheredge

# Weather Underground API key (optional — for historical station data)
# WU_API_KEY=

# NOAA Climate Data Online token (optional)
# NOAA_CDO_TOKEN=
